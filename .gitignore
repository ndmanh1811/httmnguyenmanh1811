# Keep application models in models_dir
!ppe-detection-demo/backend/models_dir/*.pt
!ppe-detection-demo/backend/models_dir/*.pth

# Static media runtime files (preserve .gitkeep)
ppe-detection-demo/backend/static/evidence/*
!ppe-detection-demo/backend/static/evidence/.gitkeep
ppe-detection-demo/backend/static/outputs/*
!ppe-detection-demo/backend/static/outputs/.gitkeep
ppe-detection-demo/backend/static/uploads/*
!ppe-detection-demo/backend/static/uploads/.gitkeep
